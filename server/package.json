{
  "name": "server-nest",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "build": "nest build && npm run build:native",
    "build:native": "node build-native.mjs",
    "test:native": "vitest run src/storage/linux-physical-storage.observer.spec.ts",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "oxlint --type-aware src/ test/",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "test:debug": "vitest --inspect-brk --no-file-parallelism",
    "test:e2e": "vitest run --config ./vitest.config.e2e.ts",
    "test:integration": "npm run build && node ./test/run-integration.mjs",
    "test:runtime-smoke": "npm run build && node ./test/runtime-smoke.mjs",
    "test:migrations": "npm run build && node ./test/run-integration.mjs --migrations",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "db:status": "npm run build && node dist/database/migrations/cli.js status",
    "db:migrate": "npm run build && node dist/database/migrations/cli.js up",
    "storage:provision-fresh": "npm run build && node dist/storage/storage-operator-cli.js provision-fresh",
    "storage:adopt-historical": "npm run build && node dist/storage/storage-operator-cli.js adopt-historical",
    "storage:reestablish-location": "npm run build && node dist/storage/storage-operator-cli.js reestablish-location",
    "auth:bootstrap": "npm run build && node dist/users/operator-cli.js bootstrap",
    "auth:recover": "npm run build && node dist/users/operator-cli.js recover",
    "auth:prune-sessions": "npm run build && node dist/users/operator-cli.js prune",
    "start:worker": "node dist/worker/main.js",
    "test:redis": "npm run build && node ./test/run-redis.mjs",
    "recovery:permit": "npm run build && node dist/worker/recovery-permit-operator-cli.js"
  },
  "dependencies": {
    "@fastify/multipart": "^10.1.4",
    "@fastify/static": "^10.1.6",
    "@nestjs/common": "^12.0.1",
    "@nestjs/config": "^12.0.1",
    "@nestjs/core": "^12.0.1",
    "@nestjs/platform-fastify": "^12.1.3",
    "@nestjs/swagger": "^12.0.2",
    "argon2": "^0.45.1",
    "bullmq": "5.81.5",
    "kysely": "^0.29.6",
    "pg": "^8.23.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.0",
    "@nestjs/schematics": "^12.0.0",
    "@nestjs/testing": "^12.0.1",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.23.1",
    "@vitest/coverage-v8": "^4.1.2",
    "oxlint": "^1.58.0",
    "oxlint-tsgolint": "^7.0.2001",
    "prettier": "^3.4.2",
    "source-map-support": "^0.5.21",
    "typescript": "^6.0.2",
    "vite": "^8.0.0",
    "vitest": "^4.1.2"
  }
}
