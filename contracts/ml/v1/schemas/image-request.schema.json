{
  "$comment": "Draft proposal. Shape validation only; use cross-field checks for vector dimension/norm and request/result binding.",
  "$defs": {
    "ImageDescriptor": {
      "additionalProperties": false,
      "properties": {
        "byte_size": {
          "maximum": 20971520,
          "minimum": 1,
          "title": "Byte Size",
          "type": "integer"
        },
        "media_type": {
          "enum": [
            "image/jpeg",
            "image/png",
            "image/webp"
          ],
          "title": "Media Type",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        }
      },
      "required": [
        "sha256",
        "byte_size",
        "media_type"
      ],
      "title": "ImageDescriptor",
      "type": "object"
    },
    "ModelSpec": {
      "additionalProperties": false,
      "properties": {
        "artifact_digest": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Artifact Digest",
          "type": "string"
        },
        "dimensions": {
          "maximum": 4096,
          "minimum": 1,
          "title": "Dimensions",
          "type": "integer"
        },
        "model_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._/-]{0,199}$",
          "title": "Model Id",
          "type": "string"
        },
        "preprocessing_digest": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Preprocessing Digest",
          "type": "string"
        },
        "revision": {
          "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$",
          "title": "Revision",
          "type": "string"
        }
      },
      "required": [
        "model_id",
        "revision",
        "artifact_digest",
        "preprocessing_digest",
        "dimensions"
      ],
      "title": "ModelSpec",
      "type": "object"
    },
    "Subject": {
      "additionalProperties": false,
      "properties": {
        "asset_id": {
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
          "title": "Asset Id",
          "type": "string"
        },
        "generation": {
          "maximum": 9007199254740991,
          "minimum": 1,
          "title": "Generation",
          "type": "integer"
        },
        "scope_id": {
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
          "title": "Scope Id",
          "type": "string"
        }
      },
      "required": [
        "asset_id",
        "scope_id",
        "generation"
      ],
      "title": "Subject",
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "image": {
      "$ref": "#/$defs/ImageDescriptor"
    },
    "model": {
      "$ref": "#/$defs/ModelSpec"
    },
    "request_id": {
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
      "title": "Request Id",
      "type": "string"
    },
    "schema_version": {
      "const": "1",
      "title": "Schema Version",
      "type": "string"
    },
    "subject": {
      "$ref": "#/$defs/Subject"
    },
    "task": {
      "const": "image_embedding",
      "title": "Task",
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "task",
    "request_id",
    "subject",
    "model",
    "image"
  ],
  "title": "ImageRequest",
  "type": "object"
}
