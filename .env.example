# Copy to .env before running docker compose:  cp .env.example .env

# --- PostgreSQL ---
DB_USERNAME=saefr
DB_PASSWORD=change-me-local-password
DB_DATABASE=saefr_photos

# --- Storage ---
# Where your original photos and videos are kept on the host. Point this at a
# real folder on a drive with room to grow — this is the library itself, so
# it's what you back up. Use forward slashes on Windows.
#   Windows : D:/Saefr Photos
#   Linux   : /mnt/photos/saefr
#   macOS   : /Users/you/Saefr Photos
# Defaults to ./uploads inside the project folder if left unset.
UPLOADS_PATH=./uploads

# --- Auth ---
# Generate a real secret, never a guessable string:
#   openssl rand -base64 32
JWT_SECRET=replace-me-with-openssl-rand-base64-32
